<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#A9016D"
                android:endColor="#740182"
                android:gradientRadius="45dp"
                android:type="linear"/>

            <corners android:radius="30dp"/>  <!-- Rounded corners -->
        </shape>
    </item>
</layer-list>
