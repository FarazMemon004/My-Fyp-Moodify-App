<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">


    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/darkPurple"
                android:endColor="@color/dark_background"/>
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="top"
            android:alpha="0.4"
            android:src="@drawable/soundwaves" />
    </item>

</layer-list>
