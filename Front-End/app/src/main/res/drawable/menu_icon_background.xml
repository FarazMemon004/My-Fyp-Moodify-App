<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background shape (Rounded Rectangle) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#121020"/> <!-- Dark Background Color -->
            <corners android:radius="30dp"/> <!-- Rounded Corners -->
            <stroke android:width="2dp" android:color="#505050"/> <!-- Border -->
        </shape>
    </item>
</layer-list>